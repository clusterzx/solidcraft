# Settings for compose.yaml: copy this file to .env next to it and fill it in (docs/web-mcp.md).
# .env holds a secret: keep it out of version control and readable only by you (chmod 600 .env).

# The relay's token (required for the relay): make one with `openssl rand -hex 32`. Agents send it
# as `Authorization: Bearer …`; open the app once as https://HOST/#mcp=… to connect a tab.
SOLIDCRAFT_RELAY_TOKEN=

# Whose images to pull from GitHub's container registry, and which tag (a fork that publishes
# its own: its owner, and the branch it published from, such as web-mcp).
SOLIDCRAFT_IMAGE_OWNER=clusterzx
SOLIDCRAFT_TAG=web-mcp

# The host port of the web app (put a TLS reverse proxy in front of it).
SOLIDCRAFT_PORT=8080

# The app's public address, for the hints agents get (default: worked out from each request).
SOLIDCRAFT_RELAY_PUBLIC_URL=

# Other sites whose pages may connect a tab, comma-separated (the app's own site always may).
SOLIDCRAFT_RELAY_ALLOWED_ORIGIN=

# off (default): calls need a tab. fallback: while no tab is connected, calls go to the relay's
# own headless session (another design; its files stay on the server in the relay-data volume).
# only: always the relay's own session.
SOLIDCRAFT_RELAY_HEADLESS=off
